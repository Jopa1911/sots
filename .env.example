# Kopirati u .env i popuniti. Bez jezičkog modela agent radi sa šablonima i pravilima (LLM_PROVIDER=mock).
LLM_PROVIDER=mock

# Jezički model preko API-ja kompatibilnog sa OpenAI (OpenAI, Groq, Gemini ili lokalni Ollama):
# LLM_PROVIDER=openai        # openai | groq | gemini | ollama
# LLM_MODEL=naziv-modela
# LLM_API_KEY=
# LLM_BASE_URL=              # potrebno samo za drugu adresu, npr. http://localhost:11434/v1

# Poseban (npr. jači) model istog provajdera, samo za pretvaranje vanila rečenice u grubu:
# REWRITER_LLM_MODEL=

# Komponente: auto = najbolje što je dostupno, uz rezervu koja radi bez interneta
VANILLA_BACKEND=auto        # auto | template | llm
REWRITER_BACKEND=auto       # auto | rules | llm | seq2seq (models/rewriter)
CLASSIFIER_BACKEND=auto     # auto | rules | ml (models/strategy_clf.joblib) | llm
METER_BACKEND=lexicon       # lexicon | hf | llm

# Bezbednost grubih rečenica
ALLOW_MILD_PROFANITY=false  # damn, hell, crap
ALLOW_STRONG_INSULTS=false  # idiot, stupid...

# Razgovor
TEACHER_ANGER_THRESHOLD=5
MAX_MINUTES=8
# SEED=1

# Glas (opciono, requirements-optional.txt)
STT_BACKEND=none            # none | faster-whisper
TTS_BACKEND=none            # none | gtts | pyttsx3
WHISPER_MODEL=base.en
